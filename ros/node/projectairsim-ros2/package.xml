<?xml version="1.0"?>
<package format="3">
  <name>projectairsim_ros2</name>
  <version>0.1.1</version>
  <description>Native ROS 2 bridge between Project AirSim and ROS 2 Humble.</description>
  <maintainer email="opensource@iamaisim.com">IAMAI Simulations</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>projectairsim_rosbridge</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <!-- Optional: only required to launch projectairsim_px4_bridge.launch.py for PX4 offboard
       control. Install with ros-humble-mavros and ros-humble-mavros-extras, then run
       `ros2 run mavros install_geographiclib_datasets.sh`. -->
  <exec_depend>mavros</exec_depend>

  <test_depend>ament_pytest</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
